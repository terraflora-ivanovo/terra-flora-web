# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Service role (только для scripts/import-business.mjs, не в клиент!)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Web Push (VAPID)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:owner@example.com

# Опционально: прежние каналы уведомлений демо-тенанта
VITE_GOOGLE_SHEET_URL=
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Демо-slug по умолчанию для редиректа с /
VITE_DEFAULT_TENANT_SLUG=terra-flora
